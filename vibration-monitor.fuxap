    "svgcontent": "<svg width=\"1600\" height=\"960\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\"><g><title>Layer 1</title><rect id=\"svg_3afd8e08-2046-48c5-ad72-499f8891c736\" x=\"0\" y=\"0\" width=\"1600\" height=\"960\" rx=\"0\" fill=\"#141c26\" stroke=\"none\" stroke-width=\"0\"/><text id=\"svg_76aa1682-c7b6-408c-9d5c-ff6271ea31b5\" x=\"20\" y=\"34\" font-size=\"24\" font-family=\"sans-serif\" fill=\"#e8eef5\" text-anchor=\"start\" font-weight=\"bold\" stroke-width=\"0\" xml:space=\"preserve\">VIBRATION MONITOR</text><text id=\"svg_9abde085-dee3-4d4f-bdc1-a224622ece0e\" x=\"20\" y=\"58\" font-size=\"13\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Machine 1 \u00b7 servo axes following virtual master</text><text id=\"svg_a59c8840-2ced-4cc3-928c-a7a546667fa8\" x=\"20\" y=\"92\" font-size=\"14\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Master speed</text><g id=\"VAL_6394a7b9-a9df-4f46-9fe8-bde40e96884b\" type=\"svg-ext-value\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" stroke-width=\"0\" text-anchor=\"end\"><text id=\"VAL_5cbe26f9-5311-4935-873f-79fe216b3453\" x=\"260\" y=\"92\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" text-anchor=\"end\" stroke-width=\"0\" xml:space=\"preserve\">###0.0</text></g><text id=\"svg_9248abcb-bf0a-4fa5-9346-b01a275fb448\" x=\"20\" y=\"116\" font-size=\"14\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Master angle</text><g id=\"VAL_07b24f46-50d0-4f89-89ab-cc64ea7e2d23\" type=\"svg-ext-value\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" stroke-width=\"0\" text-anchor=\"end\"><text id=\"VAL_d6ed7f73-fc1f-4164-a20e-e6e576ffa870\" x=\"260\" y=\"116\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" text-ancho