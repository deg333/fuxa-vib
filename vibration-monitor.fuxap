    "svgcontent": "<svg width=\"1600\" height=\"960\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\"><g><title>Layer 1</title><rect id=\"svg_16c77835-0983-4362-b877-9b5cabeab31b\" x=\"0\" y=\"0\" width=\"1600\" height=\"960\" rx=\"0\" fill=\"#141c26\" stroke=\"none\" stroke-width=\"0\"/><text id=\"svg_72442ecf-368d-4de9-8c1b-ed7460c7e237\" x=\"20\" y=\"34\" font-size=\"24\" font-family=\"sans-serif\" fill=\"#e8eef5\" text-anchor=\"start\" font-weight=\"bold\" stroke-width=\"0\" xml:space=\"preserve\">VIBRATION MONITOR</text><text id=\"svg_35c17e66-426e-49c1-9456-e13e8c6aeb43\" x=\"20\" y=\"58\" font-size=\"13\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Machine 1 \u00b7 servo axes following virtual master</text><text id=\"svg_77019f1b-a60f-4d9f-aa55-8df206f3b1fc\" x=\"20\" y=\"92\" font-size=\"14\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Master speed</text><g id=\"VAL_57907937-8950-4aef-9d0f-dabf61ec8193\" type=\"svg-ext-value\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" stroke-width=\"0\" text-anchor=\"end\"><text id=\"VAL_867e6f71-04ea-4d22-97d0-a64e2f5c6c74\" x=\"260\" y=\"92\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" text-anchor=\"end\" stroke-width=\"0\" xml:space=\"preserve\">###0.0</text></g><text id=\"svg_c156993d-3325-4fe9-b6e7-5b4a4bcc43ac\" x=\"20\" y=\"116\" font-size=\"14\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Master angle</text><g id=\"VAL_ecc3f493-e6e9-4763-804c-fd665f495c52\" type=\"svg-ext-value\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" stroke-width=\"0\" text-anchor=\"end\"><text id=\"VAL_2a82409a-ff70-4848-93c0-4a97c089f118\" x=\"260\" y=\"116\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" text-ancho