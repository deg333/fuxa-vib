    "svgcontent": "<svg width=\"1600\" height=\"960\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\"><g><title>Layer 1</title><rect id=\"svg_2b68c332-9f74-47db-96b6-b142e4108081\" x=\"0\" y=\"0\" width=\"1600\" height=\"960\" rx=\"0\" fill=\"#141c26\" stroke=\"none\" stroke-width=\"0\"/><text id=\"svg_c523e532-7c65-4411-9791-acb8141f94f6\" x=\"20\" y=\"34\" font-size=\"24\" font-family=\"sans-serif\" fill=\"#e8eef5\" text-anchor=\"start\" font-weight=\"bold\" stroke-width=\"0\" xml:space=\"preserve\">VIBRATION MONITOR</text><text id=\"svg_ca370739-7fb9-4d6b-9c65-2b832614b9c3\" x=\"20\" y=\"58\" font-size=\"13\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Machine 1 \u00b7 servo axes following virtual master</text><text id=\"svg_87268490-2754-4558-b040-f1f1a6c2c15a\" x=\"20\" y=\"92\" font-size=\"14\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Master speed</text><g id=\"VAL_6fe0a903-a70e-42a3-b1f5-c2bd90aa733b\" type=\"svg-ext-value\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" stroke-width=\"0\" text-anchor=\"end\"><text id=\"VAL_ec58eb28-09c0-4fa8-9f98-dd9cd9cce560\" x=\"260\" y=\"92\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" text-anchor=\"end\" stroke-width=\"0\" xml:space=\"preserve\">###0.0</text></g><text id=\"svg_099ca258-c68d-43f4-91eb-8285221f644b\" x=\"20\" y=\"116\" font-size=\"14\" font-family=\"sans-serif\" fill=\"#8fa3b8\" text-anchor=\"start\" stroke-width=\"0\" xml:space=\"preserve\">Master angle</text><g id=\"VAL_efedacb5-648d-4c5a-b848-f304b19dbd65\" type=\"svg-ext-value\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" stroke-width=\"0\" text-anchor=\"end\"><text id=\"VAL_619bf3ae-f60e-449d-8b4d-6ecd997c7e1c\" x=\"260\" y=\"116\" fill=\"#e8eef5\" font-size=\"16\" font-family=\"sans-serif\" text-ancho